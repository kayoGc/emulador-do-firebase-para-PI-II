rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Public read for product images; modifications require authentication
    match /images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default: Everything else requires authentication for read and write
    match /{otherPath=**} {
      allow read, write: if request.auth != null;
    }
  }
}